RewriteEngine on

RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !=/server-status
RewriteRule ^.*$ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

RewriteCond  %{HTTP_HOST} ^mojapsychologia\.online
RewriteRule  (.*) https://www.mojapsychologia.online/$1 [R=301,L]
RewriteCond  %{HTTP_HOST} mojapsychologia\.online/index.php
RewriteRule  (.*) https://www.mojapsychologia.online/ [R=301,L]

RewriteRule ^$ /index.php [L,QSA]
RewriteRule ^/$ /index.php [L,QSA]
RewriteRule ^admin$ /admin/index.php [L,QSA]
RewriteRule ^admin/$ /admin/index.php [L,QSA]

RewriteRule ^([^\.\?/]+)$ /index.php?page=$1 [L,QSA]
RewriteRule ^([^\.\?/]+)/([^\.\?/]*)$ /index.php?page=$1&page2=$2 [L,QSA]
RewriteRule ^([^\.\?/]+)/([^\.\?/]+)/([^\.\?/]*)$ /index.php?page=$1&page2=$2&page3=$3 [L,QSA]
RewriteRule ^([^\.\?/]+)/([^\.\?/]+)/([^\.\?/]+)/([^\.\?/]*)$ /index.php?page=$1&page2=$2&page3=$3&page4=$4 [L,QSA]

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home2/wjmnphny/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home2/wjmnphny/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit
